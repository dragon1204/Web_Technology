generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PumpControlMode {
  AUTO
  ON
  OFF
}

model User {
  id                 Int            @id @default(autoincrement())
  email              String         @unique
  name               String?
  password           String         @default("")
  role               Role           @default(USER)
  avatar             String?
  provider           String?
  providerId         String?
  hashedRt           String?
  isTwoFactorEnabled Boolean        @default(false)
  totpSecret         String?
  gardens            Garden[]
  notifications      Notification[]
}

model Vegetable {
  id            Int                @id @default(autoincrement())
  name          String
  imported      Int                @default(0)
  sold          Int                @default(0)
  price         Float              @default(0)
  category      String?            // Loại rau: 'leafy', 'root', 'fruit', 'herb', etc.
  description   String?            // Mô tả
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sales         Sale[]
  gardens       VegetableGarden[]
  priceHistory  PriceHistory[]

  @@index([category])
  @@index([createdAt])
}

model Garden {
  id        Int     @id @default(autoincrement())
  name      String
  ownerId   Int
  owner     User    @relation(fields: [ownerId], references: [id])
  deviceMac String? @unique
  device    Device? @relation(fields: [deviceMac], references: [deviceMac])

  sales       Sale[]
  vegetables  VegetableGarden[]
  alertRules  AlertRule[]
  temperature Float?
  humidity    Float?
  soil        Float?
  timestamp   DateTime?
  pumpControl PumpControlMode?  @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VegetableGarden {
  id          Int       @id @default(autoincrement())
  vegetableId Int
  gardenId    Int
  quantity    Int // số lượng cây
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id], onDelete: Cascade)
}

model Sale {
  id          Int       @id @default(autoincrement())
  quantity    Int
  total       Float
  time        DateTime  @default(now())
  gardenId    Int
  vegetableId Int
  priceAtSale Float
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id], onDelete: Cascade)
}

model Device {
  id        Int          @id @default(autoincrement())
  model     String
  name      String
  deviceMac String       @unique
  garden    Garden?
  data      SensorData[]
}
 
model SensorData {
  id           Int      @id @default(autoincrement())
  deviceMac    String
  device       Device   @relation(fields: [deviceMac], references: [deviceMac], onDelete: Cascade)
  temperature  Float?
  humidity     Float?
  soil         Float?
  soilDigital  Int?
  lightDigital Int?
  timestamp    DateTime @default(now())

  @@index([timestamp])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  action       String
  entityType   String?
  entityId     String?
  userId       Int?
  changes      Json?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  success      Boolean  @default(true)
  errorMessage String?
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([timestamp])
  @@index([requestId])
}

model Notification {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  message     String
  type        String    // 'alert', 'info', 'warning', 'success'
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AlertRule {
  id          Int       @id @default(autoincrement())
  sensorId    Int?      // Legacy field - kept for compatibility
  sensorType  String?   // 'temperature', 'humidity', etc.
  minValue    Float?
  maxValue    Float?
  alertOnMin  Boolean   @default(false)
  alertOnMax  Boolean   @default(false)
  severity    String    @default("warning") // 'info', 'warning', 'critical'
  isActive    Boolean   @default(true)
  gardenId    Int
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  alerts      Alert[]

  @@index([gardenId])
  @@index([sensorId])
}

model Alert {
  id          Int       @id @default(autoincrement())
  ruleId      Int
  sensorId    Int?      // Legacy field - kept for compatibility
  value        Float
  message     String
  severity    String    // 'info', 'warning', 'critical'
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  rule        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([sensorId])
  @@index([isResolved])
  @@index([createdAt])
}

model PriceHistory {
  id          Int       @id @default(autoincrement())
  vegetableId Int
  price       Float
  changedAt   DateTime  @default(now())
  changedBy   Int?      // userId
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id], onDelete: Cascade)

  @@index([vegetableId, changedAt])
  @@index([changedAt])
}

model ReportTemplate {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  type        String    // 'revenue', 'productivity', 'sensor', 'custom'
  config      Json      // Cấu hình báo cáo (filters, fields, etc.)
  userId      Int?      // User tạo báo cáo (null = system template)
  isPublic    Boolean   @default(false) // Có thể chia sẻ với user khác
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([userId])
}
