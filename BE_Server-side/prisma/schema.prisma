generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String?
  password           String   @default("")
  role               Role     @default(USER)
  avatar             String?
  provider           String?
  providerId         String?
  hashedRt           String?
  isTwoFactorEnabled Boolean  @default(false)
  totpSecret         String?
  gardens            Garden[]
}

model Vegetable {
  id       Int                @id @default(autoincrement())
  name     String
  imported Int                @default(0)
  sold     Int                @default(0)
  price    Float              @default(0)
  sales    Sale[]
  gardens  vegetable_garden[]
}

model Garden {
  id         Int                @id @default(autoincrement())
  name       String
  ownerId    Int
  owner      User               @relation(fields: [ownerId], references: [id])
  sales      Sale[]
  sensors    Sensor[]
  vegetables vegetable_garden[]
}

model vegetable_garden {
  id          Int       @id @default(autoincrement())
  vegetableId Int
  gardenId    Int
  quantity    Int
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id], onDelete: Cascade)
}

model Sale {
  id          Int       @id @default(autoincrement())
  quantity    Int
  total       Float
  time        DateTime  @default(now())
  gardenId    Int
  vegetableId Int
  priceAtSale Float
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id], onDelete: Cascade)
}

model SensorType {
  id      Int      @id @default(autoincrement())
  name    String
  unit    String
  sensors Sensor[]
}

model Sensor {
  id       Int          @id @default(autoincrement())
  model    String
  name     String
  typeId   Int
  gardenId Int
  garden   Garden       @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  type     SensorType   @relation(fields: [typeId], references: [id], onDelete: Cascade)
  data     SensorData[]
}

model SensorData {
  id       Int      @id @default(autoincrement())
  time     DateTime @default(now())
  sensorId Int
  sensor   Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  action       String
  entityType   String?
  entityId     String?
  userId       Int?
  changes      Json?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  success      Boolean  @default(true)
  errorMessage String?
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([timestamp])
  @@index([requestId])
}

enum Role {
  USER
  ADMIN
}
