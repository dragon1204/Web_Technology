generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PumpControlMode {
  AUTO
  ON
  OFF
}

model User {
  id       Int      @id @default(autoincrement())
  name     String?
  email    String   @unique
  password String   @default("")
  role     Role     @default(USER)
  gardens  Garden[]
}

model Vegetable {
  id      Int               @id @default(autoincrement())
  name    String
  gardens VegetableGarden[]
  sales   Sale[]
}

model Garden {
  id        Int     @id @default(autoincrement())
  name      String
  ownerId   Int
  owner     User    @relation(fields: [ownerId], references: [id])
  deviceMac String? @unique
  device    Device? @relation(fields: [deviceMac], references: [deviceMac])

  sales       Sale[]
  vegetables  VegetableGarden[]
  temperature Float?
  humidity    Float?
  soil        Float?
  timestamp   DateTime?
  pumpControl PumpControlMode?  @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VegetableGarden {
  id          Int       @id @default(autoincrement())
  vegetableId Int
  gardenId    Int
  quantity    Int       @default(0)
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id], onDelete: Cascade)
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)

  @@map("vegetable_garden")
}

model Sale {
  id          Int       @id @default(autoincrement())
  quantity    Int
  total       Float
  time        DateTime  @default(now())
  gardenId    Int
  vegetableId Int
  priceAtSale Float
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id], onDelete: Cascade)
}

model Device {
  id        Int          @id @default(autoincrement())
  model     String
  name      String
  deviceMac String       @unique
  garden    Garden?
  data      SensorData[]
}

model SensorData {
  id           Int      @id @default(autoincrement())
  deviceMac    String
  device       Device   @relation(fields: [deviceMac], references: [deviceMac], onDelete: Cascade)
  temperature  Float?
  humidity     Float?
  soil         Float?
  soilDigital  Int?
  lightDigital Int?
  timestamp    DateTime @default(now())

  @@index([timestamp])
}
